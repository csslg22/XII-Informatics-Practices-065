# Add a new column 'Result': Marks >= 40 is 'Pass', Marks < 40 is 'Fail'.

df['Result'] = np.where(df['Marks']>=40, 'Pass', 'Fail')
df


# Create a column 'Grade':
'''
Marks >= 90 -> 'A'
Marks >= 70 but <= 89 -> 'B'
Marks >= 50 but <= 69 -> 'C'
Marks < 50 -> 'D'
'''

conditions = [
    (df['Marks'] >= 90),
    ((df['Marks'] >= 70) & (df['Marks'] <= 89)),
    ((df['Marks'] >= 50) & (df['Marks'] <= 69)),
    (df['Marks'] < 50)
]

choices = ['A', 'B', 'C', 'D']

df['Grade'] = np.select(conditions, choices, default='D')
df


